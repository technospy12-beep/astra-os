# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Weather API (OpenWeatherMap)
NEXT_PUBLIC_WEATHER_API_KEY=your_key_here
NEXT_PUBLIC_WEATHER_LAT=9.9312
NEXT_PUBLIC_WEATHER_LON=76.2673

# News API
NEXT_PUBLIC_NEWS_API_KEY=your_key_here

# OpenAI / AI
OPENAI_API_KEY=your_key_here
NEXT_PUBLIC_AI_MODEL=gpt-3.5-turbo

# Google Maps
NEXT_PUBLIC_MAPS_API_KEY=your_key_here

# System Configuration
NEXT_PUBLIC_SYSTEM_NAME=ASTRA OS
NEXT_PUBLIC_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_VOICE_ENABLED=true
NEXT_PUBLIC_AI_CHAT_ENABLED=true
